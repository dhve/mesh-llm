diff --git a/src/skippy/sampling_argmax.cpp b/src/skippy/sampling_argmax.cpp
new file mode 100644
index 000000000..33061da59
--- /dev/null
+++ b/src/skippy/sampling_argmax.cpp
@@ -0,0 +1,129 @@
+#include "skippy/sampling_argmax.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+#include <limits>
+#include <utility>
+
+static bool skippy_sampler_preserves_argmax(
+        uint32_t sampler_type,
+        const skippy_sampling_config * sampling,
+        bool default_order) {
+    switch (sampler_type) {
+        case SKIPPY_SAMPLER_PENALTIES:
+        {
+            // The chain maps a zero window to -1, which llama_sampler_init_penalties disables.
+            const float repeat_penalty = sampling->repeat_penalty == 0.0f ? 1.0f : sampling->repeat_penalty;
+            return sampling->penalty_last_n <= 0 ||
+                   (repeat_penalty == 1.0f &&
+                    sampling->frequency_penalty == 0.0f &&
+                    sampling->presence_penalty == 0.0f);
+        }
+        case SKIPPY_SAMPLER_DRY:
+            return sampling->dry_multiplier == 0.0f ||
+                   sampling->dry_base < 1.0f ||
+                   sampling->dry_penalty_last_n <= 0;
+        case SKIPPY_SAMPLER_TYPICAL_P:
+            // Typical sampling can drop the top token; the default order skips it outside (0, 1).
+            return sampling->typical_p >= 1.0f || (default_order && !(sampling->typical_p > 0.0f));
+        case SKIPPY_SAMPLER_XTC:
+            // XTC removes top tokens unless llama_sample_xtc_apply returns early.
+            return sampling->xtc_probability <= 0.0f || sampling->xtc_threshold > 0.5f;
+        case SKIPPY_SAMPLER_TOP_N_SIGMA:
+        case SKIPPY_SAMPLER_TOP_K:
+        case SKIPPY_SAMPLER_TOP_P:
+        case SKIPPY_SAMPLER_MIN_P:
+        case SKIPPY_SAMPLER_TEMPERATURE:
+            return true;
+        default:
+            return false;
+    }
+}
+
+bool skippy_sampling_selects_argmax(const skippy_sampling_config * sampling) {
+    if (sampling == nullptr ||
+            !(sampling->temperature <= 0.0f) ||
+            sampling->dynatemp_range > 0.0f ||
+            sampling->mirostat_mode == 1 ||
+            sampling->mirostat_mode == 2) {
+        return false;
+    }
+    const uint32_t configured_count = std::min<uint32_t>(sampling->sampler_count, SKIPPY_MAX_SAMPLERS);
+    const bool default_order = configured_count == 0;
+    const uint32_t * order = default_order ? skippy_default_sampler_order : sampling->samplers;
+    const uint32_t count = default_order ?
+            static_cast<uint32_t>(std::size(skippy_default_sampler_order)) : configured_count;
+    bool has_temperature = false;
+    for (uint32_t i = 0; i < count; ++i) {
+        if (!skippy_sampler_preserves_argmax(order[i], sampling, default_order)) {
+            return false;
+        }
+        has_temperature = has_temperature || order[i] == SKIPPY_SAMPLER_TEMPERATURE;
+    }
+    // Without the temperature sampler, dist draws from the whole distribution.
+    return has_temperature;
+}
+
+void skippy_prepare_argmax_plan(
+        skippy_argmax_plan * plan,
+        std::vector<llama_logit_bias> biases,
+        int32_t n_vocab) {
+    plan->biases = std::move(biases);
+    plan->biased.clear();
+    plan->biased_tokens.clear();
+    if (plan->biases.empty() || n_vocab <= 0) {
+        return;
+    }
+    plan->biased.assign(static_cast<size_t>(n_vocab), 0);
+    for (const llama_logit_bias & bias : plan->biases) {
+        if (bias.token < 0 || bias.token >= n_vocab || plan->biased[static_cast<size_t>(bias.token)] != 0) {
+            continue;
+        }
+        plan->biased[static_cast<size_t>(bias.token)] = 1;
+        plan->biased_tokens.push_back(bias.token);
+    }
+}
+
+llama_token skippy_select_unique_argmax(
+        const float * logits,
+        int32_t n_vocab,
+        const skippy_argmax_plan & plan) {
+    if (logits == nullptr || n_vocab <= 0) {
+        return LLAMA_TOKEN_NULL;
+    }
+    llama_token best_token = LLAMA_TOKEN_NULL;
+    float best = -std::numeric_limits<float>::infinity();
+    bool tied = false;
+    bool has_nan = false;
+    auto consider = [&](llama_token token, float value) {
+        if (std::isnan(value)) {
+            has_nan = true;
+        } else if (best_token == LLAMA_TOKEN_NULL || value > best) {
+            best = value;
+            best_token = token;
+            tied = false;
+        } else if (value == best) {
+            tied = true;
+        }
+    };
+    const uint8_t * biased = plan.biased.empty() ? nullptr : plan.biased.data();
+    for (llama_token token = 0; token < n_vocab; ++token) {
+        if (biased == nullptr || biased[token] == 0) {
+            consider(token, logits[token]);
+        }
+    }
+    for (const llama_token token : plan.biased_tokens) {
+        float value = logits[token];
+        for (const llama_logit_bias & bias : plan.biases) {
+            if (bias.token == token) {
+                value += bias.bias;
+            }
+        }
+        consider(token, value);
+    }
+    if (has_nan || tied || best_token == LLAMA_TOKEN_NULL || !std::isfinite(best)) {
+        return LLAMA_TOKEN_NULL;
+    }
+    return best_token;
+}
diff --git a/src/skippy/sampling_argmax.h b/src/skippy/sampling_argmax.h
new file mode 100644
index 000000000..119511079
--- /dev/null
+++ b/src/skippy/sampling_argmax.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "skippy/sampling.h"
+
+#include "llama.h"
+
+#include <cstdint>
+#include <vector>
+
+inline constexpr uint32_t skippy_default_sampler_order[] = {
+    SKIPPY_SAMPLER_PENALTIES,
+    SKIPPY_SAMPLER_DRY,
+    SKIPPY_SAMPLER_TOP_N_SIGMA,
+    SKIPPY_SAMPLER_TOP_K,
+    SKIPPY_SAMPLER_TYPICAL_P,
+    SKIPPY_SAMPLER_TOP_P,
+    SKIPPY_SAMPLER_MIN_P,
+    SKIPPY_SAMPLER_XTC,
+    SKIPPY_SAMPLER_TEMPERATURE,
+};
+
+struct skippy_argmax_plan {
+    bool valid = false;
+    bool eligible = false;
+    std::vector<llama_logit_bias> biases;
+    std::vector<uint8_t> biased;
+    std::vector<llama_token> biased_tokens;
+};
+
+bool skippy_sampling_selects_argmax(const skippy_sampling_config * sampling);
+
+void skippy_prepare_argmax_plan(
+        skippy_argmax_plan * plan,
+        std::vector<llama_logit_bias> biases,
+        int32_t n_vocab);
+
+// LLAMA_TOKEN_NULL when the biased maximum is tied, NaN, or not finite.
+llama_token skippy_select_unique_argmax(
+        const float * logits,
+        int32_t n_vocab,
+        const skippy_argmax_plan & plan);
